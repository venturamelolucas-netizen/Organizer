<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with Material 3 styling -->
    <style name="Theme.Organizer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/module_kanban</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Status bar and navigation bar color -->
        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/background_light</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/background_light</item>
        
        <!-- Shape appearance -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Organizer.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Organizer.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Organizer.Large</item>
    </style>

    <style name="ShapeAppearance.Organizer.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.Organizer.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Organizer.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">16dp</item>
    </style>
</resources>
