<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/app_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/app_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Title & Description -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/layout_circular_progress"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_goal_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Academia e Exercícios"
                    android:textColor="@color/app_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_goal_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Constância física para aumento de disposição"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Circular Progress Indicator -->
            <FrameLayout
                android:id="@+id/layout_circular_progress"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <ProgressBar
                    android:id="@+id/pb_circular_progress"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="45"
                    android:progressDrawable="@android:drawable/progress_horizontal"
                    style="?android:attr/progressBarStyleHorizontal" />

                <TextView
                    android:id="@+id/tv_progress_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="45%"
                    android:textColor="@color/module_kaizen"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </RelativeLayout>

        <!-- Current State vs Target State Comparison -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Current State Pill -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/app_surface_variant"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Situação Atual:"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_current_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2x por semana"
                    android:textColor="@color/app_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Target State Pill -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/module_kaizen_light"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meta Desejada:"
                    android:textColor="@color/module_kaizen"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_target_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5x por semana"
                    android:textColor="@color/module_kaizen"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Schedule/Reminder Info -->
        <TextView
            android:id="@+id/tv_goal_reminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Lembrete: Diário às 20:00"
            android:textColor="@color/app_text_secondary"
            android:textSize="11sp" />

        <!-- Actions: Ver Etapas, Sugerir IA, Excluir -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view_steps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Etapas Graduais"
                android:textSize="12sp"
                app:icon="@drawable/ic_check"
                app:iconTint="@color/module_kaizen"
                app:strokeColor="@color/module_kaizen"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_suggest_ai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IA"
                android:textSize="12sp"
                app:icon="@drawable/ic_sparkles"
                app:iconTint="@color/white"
                app:backgroundTint="@color/module_kaizen"
                style="@style/Widget.MaterialComponents.Button" />

            <ImageButton
                android:id="@+id/btn_delete_goal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Excluir Meta"
                android:src="@drawable/ic_delete"
                app:tint="@color/app_text_secondary" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
