<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_column_root"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/app_surface_variant"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/app_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Column Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_column_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:maxWidth="140dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="A Fazer"
                android:textColor="@color/app_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_column_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/tv_column_title"
                android:layout_marginStart="8dp"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/app_card_stroke"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="0"
                android:textColor="@color/app_text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_edit_list"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Editar Lista"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/app_text_secondary" />

                <ImageButton
                    android:id="@+id/btn_delete_list"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Excluir Lista"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/app_text_secondary" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Vertical Cards RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_column_cards"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:nestedScrollingEnabled="true" />

        <!-- Add Card Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_card_in_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="+ Adicionar Cartão"
            android:textColor="@color/module_kanban"
            app:strokeColor="@color/module_kanban"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
