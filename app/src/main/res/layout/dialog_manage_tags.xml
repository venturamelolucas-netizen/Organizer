<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/app_surface">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_title_manage_tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gerenciar Etiquetas"
            android:textColor="@color/app_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_create_new_tag"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:text="+ Nova"
            android:textSize="12sp"
            app:backgroundTint="@color/module_notes"
            android:textColor="@color/text_primary" />
    </RelativeLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Crie e personalize tags. A edição atualiza as notas vinculadas e a exclusão mantém o conteúdo de suas notas intacto."
        android:textColor="@color/app_text_secondary"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_manage_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="320dp"
        android:nestedScrollingEnabled="true" />

    <TextView
        android:id="@+id/tv_no_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="24dp"
        android:text="Nenhuma etiqueta criada ainda."
        android:textColor="@color/app_text_secondary"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close_manage_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Concluído"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

</LinearLayout>
