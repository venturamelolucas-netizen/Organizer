<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header / Focus Toggle -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_pomodoro"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface_light"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Pomodoro Timer"
            app:titleTextColor="@color/text_primary" />

        <!-- Main Timer Content Area -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">

            <!-- Circular Progress & Timer Center -->
            <FrameLayout
                android:id="@+id/layout_timer_circle"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_centerInParent="true">

                <ProgressBar
                    android:id="@+id/pb_pomodoro_progress"
                    android:layout_width="280dp"
                    android:layout_height="280dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="100"
                    android:progressDrawable="@android:drawable/progress_horizontal"
                    style="?android:attr/progressBarStyleHorizontal" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- Mode Indicator Pill -->
                    <TextView
                        android:id="@+id/tv_pomodoro_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/module_pomodoro_light"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="4dp"
                        android:text="FOCO PROFUNDO"
                        android:textColor="@color/module_pomodoro"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Countdown Monospace Timer -->
                    <TextView
                        android:id="@+id/tv_pomodoro_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:text="25:00"
                        android:textColor="@color/text_primary"
                        android:textSize="54sp"
                        android:textStyle="bold" />

                    <!-- Cycle Indicator -->
                    <TextView
                        android:id="@+id/tv_pomodoro_cycle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Ciclo 1 de 4"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Control Buttons (Play, Pause, Reset, Skip) -->
            <LinearLayout
                android:id="@+id/layout_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/layout_timer_circle"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_pomodoro_reset"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_pill"
                    android:contentDescription="Reiniciar"
                    android:src="@drawable/ic_reset" />

                <!-- Main Play/Pause FAB -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fab_pomodoro_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Iniciar/Pausar"
                    android:src="@drawable/ic_play"
                    app:backgroundTint="@color/module_pomodoro"
                    app:elevation="4dp"
                    app:fabSize="normal"
                    app:tint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pomodoro_skip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="Pular"
                    android:textSize="12sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
            </LinearLayout>

        </RelativeLayout>

        <!-- Stats & Config Panel (collapsible for Focus Mode) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_pomodoro_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="@color/surface_light"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/card_stroke_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_total_work"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 min"
                        android:textColor="@color/module_pomodoro"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tempo de Foco"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_total_break"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 min"
                        android:textColor="@color/module_kaizen"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tempo de Pausa"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
