<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Normal permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- Runtime permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:name="com.example.organizer.OrganizerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Organizer">

        <!-- Main Hub & Navigation -->
        <activity
            android:name="com.example.organizer.ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Organizer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 8 Functional Modules Activities -->
        <activity
            android:name="com.example.organizer.ui.kanban.KanbanActivity"
            android:exported="false"
            android:theme="@style/Theme.Organizer" />

        <activity
            android:name="com.example.organizer.ui.kaizen.KaizenActivity"
            android:exported="false"
            android:theme="@style/Theme.Organizer" />

        <activity
            android:name="com.example.organizer.ui.pomodoro.PomodoroActivity"
            android:exported="false"
            android:theme="@style/Theme.Organizer" />

        <!-- A3 Sheet requires landscape orientation per specification -->
        <activity
            android:name="com.example.organizer.ui.a3.A3Activity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Organizer" />

        <activity
            android:name="com.example.organizer.ui.fives.FiveSActivity"
            android:exported="false"
            android:theme="@style/Theme.Organizer" />

        <activity
            android:name="com.example.organizer.ui.pareto.ParetoActivity"
            android:exported="false"
            android:theme="@style/Theme.Organizer" />

        <activity
            android:name="com.example.organizer.ui.eisenhower.EisenhowerActivity"
            android:exported="false"
            android:theme="@style/Theme.Organizer" />

        <activity
            android:name="com.example.organizer.ui.eisenhower.EisenhowerTaskActivity"
            android:exported="false"
            android:theme="@style/Theme.Organizer" />

        <activity
            android:name="com.example.organizer.ui.notes.NotesActivity"
            android:exported="false"
            android:theme="@style/Theme.Organizer" />

        <!-- Settings Activity -->
        <activity
            android:name="com.example.organizer.ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Organizer" />

        <!-- Notification Receiver -->
        <receiver
            android:name="com.example.organizer.data.service.NotificationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
